{
    "name": "zealoop-backend",
    "version": "0.1.0",
    "private": true,
    "description": "Zealoop — multi-tenant AI support agent backend",
    "main": "server.js",
    "scripts": {
        "dev": "node --watch server.js",
        "start": "node server.js",
        "seed:widget-demo": "node scripts/widgetDemo.js",
        "seed": "node scripts/seed.js",
        "reset": "node scripts/reset.js",
        "test": "node scripts/runTests.js",
        "test:browser": "node scripts/runTests.js --browser",
        "test:against-running-api": "NEW_RELIC_ENABLED=false node --test tests/**/*.test.js",
        "verify:plans": "node scripts/verifyPlans.js",
        "widget:sync": "node scripts/syncWidget.js"
    },
    "dependencies": {
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.9.0",
        "newrelic": "^14.3.7",
        "node-cron": "^4.6.0",
        "proxy-addr": "^2.0.8",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "playwright": "^1.63.0"
    }
}
